 s.storyQs.map((a,i)=>`<div style="margin:10px 0"><b>${i+1}. ${a[0]}</b><div class="options">${a.slice(1).map(w=>radio(`s${si}_story${i}`,w,w)).join("")}</div></div>`).join(""),10);
 h+=q(2,"Circle the picture of naming words. [4 M]",s.naming.map((a,i)=>`<div style="margin:10px 0">${i+1}. <div class="options">${a.map(w=>{let word=w.split(" ").pop(); return radio(`s${si}_namePic${i}`,word,w)}).join("")}</div></div>`).join(""),4);
