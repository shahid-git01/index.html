function speak(text){
 if('speechSynthesis' in window){speechSynthesis.cancel(); let u=new SpeechSynthesisUtterance(text);u.rate=.75;speechSynthesis.speak(u);}
 else alert("Speech is not supported in this browser.");
}
function checkTest(si){
 const root=document.getElementById("set"+si);
 let score=0,total=80;
 const s=sets[si];
 const val=(name)=>{let e=root.querySelector(`[name="${name}"]:checked`);return e?e.value:""};
 const text=(name)=>{let e=root.querySelector(`[name="${name}"]`);return e?e.value.trim().toLowerCase():""};
 s.spell.forEach((w,i)=>{if(text(`s${si}_spell${i}`)===w)score+=1});
 // Sound sections: 12 items, expected target words
 s.begin.forEach((x,i)=>{if(val(`s${si}_beg${i}`)===x[1])score+=1});
 s.middle.forEach((x,i)=>{if(val(`s${si}_mid${i}`)===x[1])score+=1});
 s.end.forEach((x,i)=>{if(val(`s${si}_end${i}`)===x[1])score+=1});
 s.families.forEach((a,i)=>{if(val(`s${si}_fam${i}`)!==a[1] && val(`s${si}_fam${i}`)!==a[2]){}else score+=1}); // either related family word accepted
 s.trees.forEach((x,i)=>{if(val(`s${si}_tree${i}`)===x[1])score+=1});
 // Drawing label
 if(text(`s${si}_treeDraw`))score+=1;
 if(text(`s${si}_copy`))score+=2;
 s.missing.forEach((x,i)=>{if(text(`s${si}_miss${i}`)===x[1])score+=1});
 s.letterPics.slice(0,3).forEach((x,i)=>{if(val(`s${si}_letter${i}`)===x[2])score+=1});
 s.copy.slice(0,4).forEach((w,i)=>{if(val(`s${si}_whole${i}`)===w)score+=1});
 s.storyQs.forEach((a,i)=>{if(val(`s${si}_story${i}`)===a[1])score+=1});
 s.naming.forEach((a,i)=>{let correct=a.find(x=>!["🏃 Run","😴 Sleep","🎵 Sing","✍️ Write","🏃 Jump","💃 Dance","😊 Happy","📖 Read","🎵 Sing","🍴 Eat"].includes(x)); if(val(`s${si}_namePic${i}`)===correct?.split(" ").pop())score+=1});
 s.match.forEach((a,i)=>{if(val(`s${si}_matchName${i}`)===a[0])score+=1});
 s.many.forEach((a,i)=>{if(text(`s${si}_many${i}`)===a[1])score+=1});
 s.sort.forEach((w,i)=>{if(val(`s${si}_sort${i}`)===(s.proper.includes(w)?"proper":"common"))score+=1});
 const lws=["letter","word","sentence","letter","word","sentence"];
 lws.forEach((x,i)=>{if(val(`s${si}_lws${i}`)===x)score+=1});
 s.match.forEach((a,i)=>{let e=root.querySelector(`[name="s${si}_m${i}"]`);if(e&&e.value===a[0])score+=1});
 const names=["Riya","dog"];names.forEach((x,i)=>{if(val(`s${si}_sentName${i}`)===x)score+=1});
 const acts=["jump","read"];acts.forEach((x,i)=>{if(val(`s${si}_act${i}`)===x)score+=1});
 document.getElementById("result"+si).innerHTML=`Your practice score: <b>${score} / ${total}</b><br><small>This online version uses automatic checking for objective answers. Drawing/copying responses are counted when an entry is provided.</small>`;
}
