 h+=q(5,"Sort the words into Proper Nouns and Common Nouns. [4 M]",`<div class="wordbank">${s.sort.join(" • ")}</div>`+s.sort.map((w,i)=>`<div style="margin:7px 0"><b>${w}</b> ${radio(`s${si}_sort${i}`,"proper","Proper Noun")} ${radio(`s${si}_sort${i}`,"common","Common Noun")}</div>`).join(""),4);
 h+=q(6,"Sort into Letters, Words and Sentences. [5 M]",`
