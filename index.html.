<style>
*{box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#f3f7fb;margin:0;color:#243447}
header{background:#2457a6;color:white;padding:22px;text-align:center}
header h1{margin:0 0 7px;font-size:28px}
header p{margin:3px;font-size:15px}
.container{max-width:1050px;margin:20px auto;padding:0 14px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.tabs button{border:0;padding:11px 18px;border-radius:8px;background:#dbe8f8;cursor:pointer;font-weight:bold}
.tabs button.active{background:#2457a6;color:#fff}
.set{display:none}.set.active{display:block}
.info{background:white;padding:15px;border-radius:10px;margin-bottom:15px;box-shadow:0 2px 8px #0001}
.section{background:#fff;margin:18px 0;padding:20px;border-radius:12px;box-shadow:0 2px 9px #0001}
.section h2{margin-top:0;color:#2457a6;border-bottom:2px solid #dbe8f8;padding-bottom:8px}
.question{padding:14px 4px;border-bottom:1px solid #e6edf5}
.question:last-child{border-bottom:0}
.qtitle{font-weight:bold;margin-bottom:10px}
.options{display:flex;flex-wrap:wrap;gap:10px}
.option{border:1px solid #c9d6e5;border-radius:9px;padding:8px 12px;background:#fafcff;cursor:pointer;display:inline-flex;align-items:center;gap:7px}
.option:hover{background:#eef5ff}
.option input{accent-color:#2457a6}
.pic{font-size:42px;display:block;margin:6px 0}
.picgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:10px 0}
.piccard{border:1px solid #ccd8e6;border-radius:10px;padding:10px;text-align:center;background:#fbfdff}
.piccard .emoji{font-size:40px;display:block}
input[type=text],textarea,select{padding:9px;border:1px solid #b9c9da;border-radius:7px;font-size:16px}
input[type=text]{width:150px}
.wordbank{background:#f5f8fc;padding:10px;border-radius:8px;margin:8px 0;line-height:2}
button.small{border:0;background:#2457a6;color:white;padding:7px 10px;border-radius:6px;cursor:pointer}
.sound{margin-left:8px}
.scorebox{position:sticky;bottom:10px;background:#fff;border:2px solid #2457a6;border-radius:12px;padding:14px;text-align:center;box-shadow:0 3px 12px #0002}
.submit{background:#198754;color:white;border:0;padding:13px 24px;border-radius:8px;font-size:17px;font-weight:bold;cursor:pointer}
.reset{background:#6c757d;color:white;border:0;padding:10px 18px;border-radius:8px;cursor:pointer;margin-left:8px}
.result{font-size:20px;font-weight:bold;margin-top:10px}
.match{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:600px}
.mrow{display:contents}
.mrow span{padding:8px;background:#f7f9fc;border:1px solid #e0e7ef}
@media(max-width:600px){header h1{font-size:22px}.section{padding:13px}.match{grid-template-columns:1fr}}
</style>
</head>
