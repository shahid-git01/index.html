const tabs=document.getElementById("tabs"), setsEl=document.getElementById("sets");
sets.forEach((s,si)=>{
  const b=document.createElement("button"); b.textContent="SET "+(si+1);
  b.onclick=()=>showSet(si); tabs.appendChild(b);
  const div=document.createElement("div"); div.className="set"; div.id="set"+si;
  div.innerHTML=buildSet(s,si); setsEl.appendChild(div);
});
function showSet(i){
 document.querySelectorAll(".tabs button").forEach((b,j)=>b.classList.toggle("active",j===i));
 document.querySelectorAll(".set").forEach((x,j)=>x.classList.toggle("active",j===i));
 window.scrollTo({top:0,behavior:"smooth"});
}
showSet(0);

function radio(name,val,label){return `<label class="option"><input type="radio" name="${name}" value="${val}"> ${label}</label>`}
function q(i,title,body,marks=1){return `<div class="question"><div class="qtitle">${i}. ${title} <span style="float:right">[${marks} M]</span></div>${body}</div>`}

function buildSet(s,si){
 let h=`<div class="info"><b>Set ${si+1}</b> — 80 Marks<br>Units: Home, Friends, Neighborhood & Community, Sharing Planet with Plants</div>`;
 h+=`<div class="section"><h2>ELGA PART A — Vocabulary & Writing</h2>`;
 h+=q(1,"Write the spelling of the word you hear. [4 M]",s.spell.map((w,i)=>`<div style="margin:9px 0">${i+1}. <button class="small" onclick="speak('${w}')">🔊 Hear</button> <input type="text" name="s${si}_spell${i}" placeholder="Write word"></div>`).join(""),4);
 h+=q(2,"Listen to the sound. Circle the picture with that sound — Beginning, Middle and End sounds. [12 M]",
 `<h4>Beginning sound</h4><div class="picgrid">${s.begin.map((x,i)=>`<div class="piccard">${radio(`s${si}_beg${i}`,x[1],x[0]+" "+x[1])}</div>`).join("")}</div>
 <h4>Middle sound</h4><div class="picgrid">${s.middle.map((x,i)=>`<div class="piccard">${radio(`s${si}_mid${i}`,x[1],x[0]+" "+x[1])}</div>`).join("")}</div>
 <h4>End sound</h4><div class="picgrid">${s.end.map((x,i)=>`<div class="piccard">${radio(`s${si}_end${i}`,x[1],x[0]+" "+x[1])}</div>`).join("")}</div>
 <p><button class="small" onclick="speak('cat, dog, pen, sun')">🔊 Hear the sounds/words</button></p>`,12);
 h+=q(3,"Choose the picture/word from the same word family. [4 M]",
 s.families.map((a,i)=>`<div style="margin:9px 0">${i+1}. <b>${a[0]}</b> family:
 ${a.slice(1).map(w=>radio(`s${si}_fam${i}`,w,w+" 🔤")).join("")}</div>`).join(""),4);
 h+=q(4,"Draw and label things which we get from trees. [6 M]",
 `<div class="picgrid">${s.trees.map((x,i)=>`<div class="piccard">${radio(`s${si}_tree${i}`,x[1],x[0]+" "+x[1])}</div>`).join("")}</div>
 <p><b>Practice drawing:</b> 🌳 Draw one thing we get from a tree and write its name: <input type="text" name="s${si}_treeDraw" placeholder="Name"></p>`,6);
 h+=q(5,"Copy the words. [2 M]",`<div class="wordbank">${s.copy.slice(0,2).join(" &nbsp;&nbsp; ")}</div><input type="text" name="s${si}_copy" style="width:90%" placeholder="Copy the words here">`,2);
 h+=q(6,"Write the missing letters in the words. [5 M]",s.missing.map((x,i)=>`${i+1}. <b>${x[0]}</b> <input type="text" name="s${si}_miss${i}" maxlength="1" style="width:45px">`).join(" &nbsp; "),5);
 h+=q(7,"See the letter and draw/select a picture that begins with it. [3 M]",s.letterPics.slice(0,3).map((x,i)=>`<div style="margin:10px 0"><b>${x[0]}</b> ${radio(`s${si}_letter${i}`,x[2],x[1]+" "+x[2])}</div>`).join(""),3);
 h+=q(8,"Circle the whole words. [4 M]",`<div class="options">${s.copy.slice(0,4).map((w,i)=>radio(`s${si}_whole${i}`,w,w)).join("")}</div>`,4);
