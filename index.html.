 h+=q(7,"Match the pictures with the words. [5 M]",`<div class="match">${s.match.map((a,i)=>`<span>${a[1]}</span><span><select name="s${si}_m${i}"><option value="">Choose</option>${s.match.map(x=>`<option>${x[0]}</option>`).join("")}</select></span>`).join("")}</div>`,5);
 h+=q(8,"Circle the naming words in the sentences. [3 M]",[
